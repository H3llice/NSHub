generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id           Int      @id @default(autoincrement())
  nome         String
  sigla        String   @unique
  endereco     String
  cidade       String
  cep          String
  cnpj         String
  inscEstadual String?
  telefone     String?
  email        String?
  criadoEm     DateTime @default(now())

  ordensCompra  OrdemCompra[]
  solicitacoes  SolicitacaoCompra[]
  relatorios    Relatorio[]
  ordensServico OrdemServico[]
  certificados  Certificado[]
}

model Fornecedor {
  id           Int      @id @default(autoincrement())
  nome         String
  endereco     String?
  cidade       String?
  cep          String?
  documento    String?
  inscEstadual String?
  telefone     String?
  chavePix     String?
  tipoConta    String?
  // tipoConta: corrente | poupanca
  agencia      String?
  contaNumero  String?
  criadoEm     DateTime @default(now())

  ordensCompra OrdemCompra[]
  vendedores   Vendedor[]
}

model Vendedor {
  id           Int        @id @default(autoincrement())
  nome         String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])
  fornecedorId Int

  ordensCompra OrdemCompra[]
}

model Usuario {
  id               Int       @id @default(autoincrement())
  nome             String
  email            String    @unique
  senha            String
  perfil           String    @default("usuario")
  tema             String    @default("azul")
  // tema: azul (padrão) | classico (verde) — preferência de UI, editável em "Editar Perfil"
  ativo            Boolean   @default(true)
  criadoEm         DateTime  @default(now())
  primeiroLogin    Boolean   @default(true)
  resetToken       String?
  resetTokenExpira DateTime?

  ordensCompra OrdemCompra[]
  assinaturas  Assinatura[]
  solicitacoes SolicitacaoCompra[]

  contratos Contrato[]

  vendasComoVendedor Venda[] @relation("VendaVendedor")
  vendasCriadas      Venda[] @relation("VendaCriadoPor")

  orcamentosComoVendedor Orcamento[] @relation("OrcamentoVendedor")
  orcamentosCriados      Orcamento[] @relation("OrcamentoCriadoPor")

  vendasOrcamentoComoVendedor VendaOrcamento[] @relation("VendaOrcamentoVendedor")
  vendasOrcamentoCriadas      VendaOrcamento[] @relation("VendaOrcamentoCriadoPor")

  pedidosAlmoxarifado PedidoAlmoxarifado[]

  relatorios    Relatorio[]
  ordensServico OrdemServico[]
  certificados  Certificado[]

  // Ficha de colaborador vinculada a este login (opcional) — é por esse vínculo que
  // o que o usuário registra (vendas, OS, etc.) conta pro colaborador.
  colaborador Colaborador?

  embarquesCriados Embarque[]
  folhasCriadas    FolhaPagamento[]
}

// etapa: solicitante | aprovacao | autorizacao
// Cada assinatura pertence a UMA OrdemCompra OU UMA SolicitacaoCompra (nunca as duas)
model Assinatura {
  id            Int                @id @default(autoincrement())
  ordemCompra   OrdemCompra?       @relation(fields: [ocId], references: [id])
  ocId          Int?
  solicitacao   SolicitacaoCompra? @relation(fields: [solicitacaoId], references: [id])
  solicitacaoId Int?
  relatorio     Relatorio?         @relation(fields: [relatorioId], references: [id])
  relatorioId   Int?
  certificado   Certificado?       @relation(fields: [certificadoId], references: [id])
  certificadoId Int?
  usuario       Usuario            @relation(fields: [usuarioId], references: [id])
  usuarioId     Int
  etapa         String
  acao          String
  motivo        String?
  assinaturaImg String?
  criadoEm      DateTime           @default(now())

  @@index([ocId])
  @@index([solicitacaoId])
  @@index([relatorioId])
  @@index([certificadoId])
}

model OrdemCompra {
  id              Int        @id @default(autoincrement())
  numero          Int
  ano             Int
  empresa         Empresa    @relation(fields: [empresaId], references: [id])
  empresaId       Int
  fornecedor      Fornecedor @relation(fields: [fornecedorId], references: [id])
  fornecedorId    Int
  vendedor        Vendedor?  @relation(fields: [vendedorId], references: [id])
  vendedorId      Int?
  criadoPor       Usuario?   @relation(fields: [criadoPorId], references: [id])
  criadoPorId     Int?
  dataPedido      DateTime   @default(now())
  condicoesPagto  String?
  formaPagto      String?
  chavePix        String?
  codigoBarras    String?
  tipoConta       String?
  agencia         String?
  contaNumero     String?
  formaPagtoOutro String?
  prazoEntrega    String?
  incoterms       String?
  transportadora  String?
  enderecoTransp  String?
  telefoneTransp  String?
  instrucoes      String?
  solicitante     String?
  status          String     @default("aguardando_solicitante")
  criadoEm        DateTime   @default(now())
  atualizadoEm    DateTime   @updatedAt
  canceladoEm     DateTime?
  valorTotal      Float?
  pago            Boolean    @default(false)
  dataPagamento   DateTime?

  geradaDeSolicitacaoId Int?               @unique
  geradaDeSolicitacao   SolicitacaoCompra? @relation("OcGerada", fields: [geradaDeSolicitacaoId], references: [id])

  itens       ItemOC[]
  anexos      Anexo[]
  assinaturas Assinatura[]

  @@index([status])
  @@index([ano, numero])
  @@index([fornecedorId])
  @@index([empresaId])
}

model ItemOC {
  id          Int         @id @default(autoincrement())
  ordemCompra OrdemCompra @relation(fields: [ocId], references: [id])
  ocId        Int
  quantidade  Float
  unidade     String?
  descricao   String
  valorUni    Float?
  // Desconto do item (antes do IPI) — valorTotal já vem com ele aplicado; guardado
  // pra que editar a OC mostre e recalcule o mesmo desconto
  descontoTipo  String?
  descontoValor Float?
  // descontoTipo: percentual | fixo
  ipi         Float?
  valorTotal  Float?

  @@index([ocId])
}

model Anexo {
  id           Int         @id @default(autoincrement())
  ordemCompra  OrdemCompra @relation(fields: [ocId], references: [id])
  ocId         Int
  nomeOriginal String
  nomeArquivo  String
  tipo         String
  mimeType     String
  criadoEm     DateTime    @default(now())

  @@index([ocId])
}

model SolicitacaoCompra {
  id                  Int      @id @default(autoincrement())
  numero              Int
  ano                 Int
  empresa             Empresa  @relation(fields: [empresaId], references: [id])
  empresaId           Int
  criadoPor           Usuario? @relation(fields: [criadoPorId], references: [id])
  criadoPorId         Int?
  dataPedido          DateTime @default(now())
  instrucoes          String?
  departamentoDestino String?
  // departamentoDestino: tecnico | administrativo
  status              String   @default("aguardando_aprovacao")
  // status: aguardando_aprovacao | aprovada | recusada | cancelada

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  canceladoEm  DateTime?

  itens        ItemSolicitacao[]
  fornecedores FornecedorCotado[]
  assinaturas  Assinatura[]

  ocGerada OrdemCompra? @relation("OcGerada")

  @@index([status])
  @@index([ano, numero])
}

model ItemSolicitacao {
  id            Int               @id @default(autoincrement())
  solicitacao   SolicitacaoCompra @relation(fields: [solicitacaoId], references: [id])
  solicitacaoId Int
  quantidade    Float
  unidade       String?
  descricao     String

  precos PrecoCotado[]

  @@index([solicitacaoId])
}

model FornecedorCotado {
  id              Int               @id @default(autoincrement())
  solicitacao     SolicitacaoCompra @relation(fields: [solicitacaoId], references: [id])
  solicitacaoId   Int
  nome            String
  documento       String?
  telefone        String?
  prazoEntrega    String?
  condicoesPagto  String?
  formaPagto      String?
  chavePix        String?
  codigoBarras    String?
  tipoConta       String?
  agencia         String?
  contaNumero     String?
  formaPagtoOutro String?
  observacoes     String?
  favorito        Boolean           @default(false)
  escolhido       Boolean           @default(false)

  precos PrecoCotado[]

  @@index([solicitacaoId])
}

model PrecoCotado {
  id                 Int              @id @default(autoincrement())
  item               ItemSolicitacao  @relation(fields: [itemSolicitacaoId], references: [id])
  itemSolicitacaoId  Int
  fornecedor         FornecedorCotado @relation(fields: [fornecedorCotadoId], references: [id])
  fornecedorCotadoId Int
  valor              Float?

  @@unique([itemSolicitacaoId, fornecedorCotadoId])
}

model Balsa {
  id            Int     @id @default(autoincrement())
  fabricante    String
  numeroSerie   String  @unique
  modelo        String
  anoFabricacao Int
  capacidade    Int
  tipo          String
  armazem       String?
  // Patrimônio é obrigatório e único, mas as duas regras são validadas em
  // routes/estoque.js e não aqui: já existiam balsas antes do campo (por isso
  // opcional) e o `prisma db push` do deploy recusa criar @unique em tabela
  // existente sem --accept-data-loss.
  patrimonio    String?
  observacoes   String?
  finalidade    String
  // finalidade: locacao | venda

  status String @default("disponivel")
  // status: disponivel | locado | vendido

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  contratosBalsa ContratoBalsa[]
  vendasBalsa    VendaBalsa[]
  documentos     DocumentoBalsa[]

  @@index([finalidade, status])
}

// Documentos da balsa (PDF ou imagem). Ficam em uploads-privado/balsas e são
// servidos só pela rota autenticada — ver routes/estoque.js
model DocumentoBalsa {
  id           Int      @id @default(autoincrement())
  balsa        Balsa    @relation(fields: [balsaId], references: [id])
  balsaId      Int
  titulo       String
  nomeOriginal String
  nomeArquivo  String
  mimeType     String
  criadoEm     DateTime @default(now())

  @@index([balsaId])
}

model Cliente {
  id         Int    @id @default(autoincrement())
  tipoPessoa String
  // tipoPessoa: fisica | juridica

  cpfCnpj  String   @unique
  nome     String
  telefone String?
  email    String?
  endereco String?
  cidade   String?
  criadoEm DateTime @default(now())

  contratos       Contrato[]
  vendas          Venda[]
  embarcacoes     Embarcacao[]
  ordensServico   OrdemServico[]
  orcamentos      Orcamento[]
  vendasOrcamento VendaOrcamento[]
  embarques       Embarque[]
}

model Embarcacao {
  id            Int      @id @default(autoincrement())
  nome          String
  // nome do navio
  armador       Cliente  @relation(fields: [armadorId], references: [id])
  armadorId     Int
  portoRegistro String?
  email         String?
  telefone      String?
  criadoEm      DateTime @default(now())

  relatorios    Relatorio[]
  ordensServico OrdemServico[]
  certificados  Certificado[]
  embarques     Embarque[]

  @@index([armadorId])
}

model Contrato {
  id                     Int       @id @default(autoincrement())
  numero                 Int
  ano                    Int
  tipo                   String
  // tipo: locacao (venda de balsa passou a ser tratada pelo model Venda)
  cliente                Cliente   @relation(fields: [clienteId], references: [id])
  clienteId              Int
  dataInicio             DateTime
  dataFim                DateTime?
  valor                  Float?
  frete                  Float?
  descontoTipo           String?
  descontoValor          Float?
  // descontoTipo: percentual | fixo
  formaPagamento         String?
  condicoesPagto         String?
  periodicidadePagamento String    @default("unico")
  observacoes            String?
  status                 String    @default("ativo")
  // status: ativo | encerrado | cancelado

  criadoPor    Usuario? @relation(fields: [criadoPorId], references: [id])
  criadoPorId  Int?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Avisos por email do vencimento (dataFim) — cada um sai uma vez só; voltam a
  // false quando a dataFim muda (renovação). Ver job em server.js
  avisoVencimentoEnviado Boolean @default(false)
  avisoVencidoEnviado    Boolean @default(false)

  balsas     ContratoBalsa[]
  pagamentos Pagamento[]
  documentos DocumentoContrato[]

  @@index([status])
  @@index([clienteId])
  @@index([ano, numero])
}

// Uma linha por passagem da balsa pelo contrato. Não é apagada quando a balsa
// sai: a devolução só preenche devolvidaEm — é isso que dá o histórico de
// locações da balsa. "Balsa no contrato agora" = devolvidaEm null. Por isso não
// há @@unique([contratoId, balsaId]): a mesma balsa pode voltar ao contrato depois.
model ContratoBalsa {
  id         Int      @id @default(autoincrement())
  contrato   Contrato @relation(fields: [contratoId], references: [id])
  contratoId Int
  balsa      Balsa    @relation(fields: [balsaId], references: [id])
  balsaId    Int
  valor      Float?
  // Nº do aditivo em que a balsa entrou (null = veio no contrato original)
  aditivo    Int?
  criadoEm   DateTime @default(now())

  // Devolução/vistoria
  devolvidaEm          DateTime?
  estadoDevolucao      String?
  // estadoDevolucao: bom | avariado | extraviado (null = saiu por cancelamento do contrato, sem vistoria)
  observacoesDevolucao String?

  @@index([contratoId])
  @@index([balsaId])
}

// Documentos do contrato (o contrato assinado, aditivos, comprovantes). Mesmo
// esquema de DocumentoBalsa — ficam em uploads-privado/contratos.
model DocumentoContrato {
  id           Int      @id @default(autoincrement())
  contrato     Contrato @relation(fields: [contratoId], references: [id])
  contratoId   Int
  titulo       String
  nomeOriginal String
  nomeArquivo  String
  mimeType     String
  criadoEm     DateTime @default(now())

  @@index([contratoId])
}

model Venda {
  id                     Int      @id @default(autoincrement())
  numero                 Int
  ano                    Int
  cliente                Cliente  @relation(fields: [clienteId], references: [id])
  clienteId              Int
  dataVenda              DateTime
  valor                  Float?
  frete                  Float?
  descontoTipo           String?
  descontoValor          Float?
  // descontoTipo: percentual | fixo
  formaPagamento         String?
  condicoesPagto         String?
  periodicidadePagamento String   @default("unico")
  // Comissão do vendedor (R$), digitada à mão por enquanto — somada na Folha de
  // pagamento do mês da venda (ver routes/folha-pagamento.js)
  comissao               Float?
  observacoes            String?
  status                 String   @default("ativo")
  // status: ativo | cancelado

  vendedor   Usuario? @relation("VendaVendedor", fields: [vendedorId], references: [id])
  vendedorId Int?

  criadoPor    Usuario? @relation("VendaCriadoPor", fields: [criadoPorId], references: [id])
  criadoPorId  Int?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  balsas     VendaBalsa[]
  pagamentos Pagamento[]

  @@index([status])
  @@index([clienteId])
  @@index([ano, numero])
}

model VendaBalsa {
  id      Int    @id @default(autoincrement())
  venda   Venda  @relation(fields: [vendaId], references: [id])
  vendaId Int
  balsa   Balsa  @relation(fields: [balsaId], references: [id])
  balsaId Int
  valor   Float?

  @@unique([vendaId, balsaId])

  @@index([balsaId])
}

model Pagamento {
  id               Int             @id @default(autoincrement())
  contrato         Contrato?       @relation(fields: [contratoId], references: [id])
  contratoId       Int?
  venda            Venda?          @relation(fields: [vendaId], references: [id])
  vendaId          Int?
  vendaOrcamento   VendaOrcamento? @relation(fields: [vendaOrcamentoId], references: [id])
  vendaOrcamentoId Int?
  clienteNome      String? // usado quando não há contrato/venda vinculado (conta avulsa)
  descricao        String? // usado quando não há contrato/venda vinculado (conta avulsa)
  referencia       String?
  valor            Float
  dataVencimento   DateTime
  dataPagamento    DateTime?
  status           String          @default("pendente")
  // status: pendente | pago | atrasado
  alertaEnviado    Boolean         @default(false)
  criadoEm         DateTime        @default(now())

  @@index([status, dataVencimento])
  @@index([contratoId])
  @@index([vendaId])
  @@index([vendaOrcamentoId])
}

model ContaPagar {
  id             Int       @id @default(autoincrement())
  fornecedorNome String? // conta avulsa (sem OC vinculada)
  descricao      String?
  referencia     String?
  valor          Float
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         String    @default("pendente")
  // status: pendente | pago
  criadoEm       DateTime  @default(now())

  @@index([status, dataVencimento])
}

model Produto {
  id                Int      @id @default(autoincrement())
  codigo            String   @unique
  nome              String
  unidade           String
  valor             Float?
  quantidade        Float    @default(0)
  quantidadeCritica Float    @default(0)
  // Quando quantidade <= quantidadeCritica (e quantidadeCritica > 0), o produto
  // entra no alerta de estoque baixo (dashboard e página do almoxarifado).
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  itensPedido    ItemPedidoAlmoxarifado[]
  itensOrcamento ItemOrcamento[]
  itensVenda     ItemVendaOrcamento[]
}

// Catálogo de serviços precificáveis (ex.: pintura de casulo, inspeção em balsa)
// — cadastro em Cadastros → Produtos e Serviços. Separado de Produto porque não
// tem estoque (quantidade/quantidadeCritica não fazem sentido pra serviço).
model Servico {
  id           Int      @id @default(autoincrement())
  nome         String
  descricao    String?
  valor        Float?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  itensOrcamento ItemOrcamento[]
  itensVenda     ItemVendaOrcamento[]
}

// ─── Orçamento (proposta comercial genérica — produtos e/ou serviços do
// catálogo, ex.: inspeção de extintores, transporte) ───────────────────────────
// Diferente de Venda (que é só venda de balsa, com VendaBalsa) — este cobre
// qualquer combinação de Produto/Servico. email/telefone são cópias próprias
// do orçamento (autopreenchidas ao selecionar o Cliente, mas editáveis por
// orçamento), mesmo padrão usado em Certificado/Venda.
// descontoModo define se o desconto é único (campos abaixo, sobre o total)
// ou por item (cada ItemOrcamento tem os próprios descontoTipo/descontoValor)
// — são mutuamente exclusivos, nunca os dois ao mesmo tempo.
model Orcamento {
  id     Int @id @default(autoincrement())
  numero Int
  ano    Int

  cliente   Cliente @relation(fields: [clienteId], references: [id])
  clienteId Int
  email     String?
  telefone  String?

  vendedor   Usuario? @relation("OrcamentoVendedor", fields: [vendedorId], references: [id])
  vendedorId Int?

  dataOrcamento   DateTime  @default(now())
  validade        DateTime?
  previsaoEntrega DateTime?

  descricao   String?
  observacoes String?

  descontoModo  String  @default("conjunto")
  // descontoModo: conjunto | item
  descontoTipo  String?
  descontoValor Float?
  // descontoTipo: percentual | fixo — só usado quando descontoModo = conjunto

  status      String @default("em_andamento")
  // status: em_andamento | aprovado | recusado | expirado | convertido
  statusEnvio String @default("nao_enviado")
  // statusEnvio: nao_enviado | enviado (marcado manualmente, sem envio de e-mail de verdade por enquanto)

  criadoPor   Usuario? @relation("OrcamentoCriadoPor", fields: [criadoPorId], references: [id])
  criadoPorId Int?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  itens          ItemOrcamento[]
  VendaOrcamento VendaOrcamento?

  @@index([status])
  @@index([clienteId])
  @@index([ano, numero])
}

// Cada item guarda cópia própria de nome/valorUnitario (sobrevive a
// alteração/exclusão do Produto/Servico de origem no catálogo, igual ao
// padrão de Certificado/Relatorio) — produtoId/servicoId só ficam pra
// rastrear a origem, nunca são a fonte de verdade depois de criado o item.
model ItemOrcamento {
  id          Int       @id @default(autoincrement())
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id])
  orcamentoId Int

  tipo      String
  // tipo: produto | servico
  produto   Produto? @relation(fields: [produtoId], references: [id])
  produtoId Int?
  servico   Servico? @relation(fields: [servicoId], references: [id])
  servicoId Int?

  nome          String
  detalhes      String?
  quantidade    Float   @default(1)
  valorUnitario Float

  descontoTipo  String?
  descontoValor Float?
  // descontoTipo/descontoValor só usados quando Orcamento.descontoModo = item

  @@index([orcamentoId])
}

// ─── Venda (de um Orçamento aprovado — "Criar Venda" — ou avulsa) ─────────────
// Não confundir com Venda (venda de balsa, com VendaBalsa). Dois jeitos de nascer:
// - de um Orcamento aprovado, 1:1 (orcamentoId é @unique: um orçamento só vira
//   venda uma vez — ao criar, o Orcamento.status vira "convertido"). valorTotal é
//   o total líquido do Orçamento no momento da conversão (cópia — se o Orçamento
//   for editado depois, a Venda não muda). Os itens ficam no próprio Orçamento.
// - avulsa (orcamentoId null): itens próprios em ItemVendaOrcamento, e
//   valorTotal é a soma deles.
// Cada parcela gera uma linha própria em Pagamento (contas a receber), com o
// valor correspondente.
model VendaOrcamento {
  id Int @id @default(autoincrement())

  numero Int
  ano    Int

  orcamento   Orcamento? @relation(fields: [orcamentoId], references: [id])
  orcamentoId Int?       @unique

  cliente   Cliente @relation(fields: [clienteId], references: [id])
  clienteId Int

  vendedor   Usuario? @relation("VendaOrcamentoVendedor", fields: [vendedorId], references: [id])
  vendedorId Int?

  dataVenda      DateTime @default(now())
  valorTotal     Float
  formaPagamento String
  // formaPagamento: avista | parcelado
  numeroParcelas Int      @default(1)
  // Comissão do vendedor (R$), digitada à mão por enquanto — somada na Folha de
  // pagamento do mês da venda (ver routes/folha-pagamento.js)
  comissao       Float?

  observacoes String?
  status      String  @default("ativo")
  // status: ativo | cancelado

  criadoPor   Usuario? @relation("VendaOrcamentoCriadoPor", fields: [criadoPorId], references: [id])
  criadoPorId Int?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  pagamentos Pagamento[]
  itens      ItemVendaOrcamento[]

  @@index([status])
  @@index([clienteId])
}

// Item de venda avulsa (sem Orçamento). Sempre aponta pro catálogo (produto/
// servico), igual ao ItemOrcamento — item que não existe é cadastrado no
// catálogo na hora, pela própria tela. nome/valorUnitario ficam copiados.
model ItemVendaOrcamento {
  id      Int            @id @default(autoincrement())
  venda   VendaOrcamento @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  vendaId Int

  tipo      String
  // tipo: produto | servico
  produto   Produto? @relation(fields: [produtoId], references: [id])
  produtoId Int?
  servico   Servico? @relation(fields: [servicoId], references: [id])
  servicoId Int?

  nome          String
  detalhes      String?
  quantidade    Float   @default(1)
  valorUnitario Float

  @@index([vendaId])
}

model PedidoAlmoxarifado {
  id            Int      @id @default(autoincrement())
  numero        Int
  ano           Int
  solicitante   Usuario? @relation(fields: [solicitanteId], references: [id])
  solicitanteId Int?
  observacoes   String?
  criadoEm      DateTime @default(now())

  itens ItemPedidoAlmoxarifado[]

  @@index([ano, numero])
}

model ItemPedidoAlmoxarifado {
  id         Int                @id @default(autoincrement())
  pedido     PedidoAlmoxarifado @relation(fields: [pedidoId], references: [id])
  pedidoId   Int
  produto    Produto            @relation(fields: [produtoId], references: [id])
  produtoId  Int
  quantidade Float
  valorUni   Float?

  @@index([pedidoId])
  @@index([produtoId])
}

// ─── Ordem de Serviço (abre o atendimento; precede o Relatório) ───────────────
// Fluxo: OS (abertura, cliente entrega equipamento) → Relatório (técnico) → Certificado (gerente, pendente).
// status: aberta | concluida — concluida quando o cliente retira o equipamento e assina o canhoto.
model OrdemServico {
  id            Int        @id @default(autoincrement())
  numero        Int
  ano           Int
  empresa       Empresa    @relation(fields: [empresaId], references: [id])
  empresaId     Int
  cliente       Cliente    @relation(fields: [clienteId], references: [id])
  clienteId     Int
  aosCuidadosDe String?
  embarcacao    Embarcacao @relation(fields: [embarcacaoId], references: [id])
  embarcacaoId  Int

  dataEmissao     DateTime  @default(now())
  dataInicio      DateTime?
  previsaoEntrega DateTime?

  equipamentoRecebido    String?
  equipNumeroSerie       String?
  equipMarca             String?
  equipModelo            String?
  // vencimentoCertificacao é texto livre (digitável), mesmo motivo dos campos de validade do Relatorio
  vencimentoCertificacao String?

  problemaApresentado String?
  servicoApresentado  String?
  observacoes         String?

  // Canhoto de conclusão — preenchido/assinado quando o cliente retira o equipamento
  dataConclusao     DateTime?
  horaEntrada       String?
  horaSaida         String?
  assinaturaCliente String?

  status       String   @default("aberta")
  criadoPor    Usuario? @relation(fields: [criadoPorId], references: [id])
  criadoPorId  Int?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  relatorio Relatorio?

  @@index([status])
  @@index([clienteId])
  @@index([ano, numero])
}

// ─── Relatório de Serviço de Balsas (etapa "Relatório" do fluxo Certificados) ──
// Fluxo: OS → Relatório (técnico) → Certificado (gerente, pendente). Todo Relatorio
// nasce de uma OrdemServico (ordemServicoId obrigatório e único).
// status: preenchendo | concluido
model Relatorio {
  id             Int           @id @default(autoincrement())
  numero         Int
  ano            Int
  empresa        Empresa       @relation(fields: [empresaId], references: [id])
  empresaId      Int
  embarcacao     Embarcacao?   @relation(fields: [embarcacaoId], references: [id])
  embarcacaoId   Int?
  // Opcional por enquanto — dá pra criar Relatório direto, sem passar por OS
  // ("+ Novo Relatório" na tela de Relatórios). Continua único quando
  // preenchido (uma OS não pode gerar dois relatórios).
  ordemServico   OrdemServico? @relation(fields: [ordemServicoId], references: [id])
  ordemServicoId Int?          @unique
  data           DateTime      @default(now())
  criadoPor      Usuario?      @relation(fields: [criadoPorId], references: [id])
  criadoPorId    Int?

  // Texto livre — mesmo padrão do Certificado avulso (não exige cadastro
  // prévio de Embarcacao/Cliente). embarcacaoId (acima) só é preenchido
  // quando o técnico escolhe uma sugestão do autocomplete; o conteúdo
  // impresso e a cópia pro Certificado sempre leem daqui primeiro, caindo
  // pro relacionamento só em relatórios antigos que não tinham esses campos.
  navio         String?
  armador       String?
  portoRegistro String?

  // Equipamento (a balsa física atendida — não confundir com a Embarcacao/navio)
  equipTipo                String?
  equipNumeroSerie         String?
  equipAnoFabricacao       String?
  equipFabricante          String?
  equipModelo              String?
  equipClasse              String?
  equipCapacidade          Int?
  certRevisaoNumero        String?
  certRevisaoDataExpedicao String?

  // Lista de verificação — kit de sobrevivência (quantidade / substituído / validade cada)
  // validade é texto livre (digitável), não data — costuma vir aproximada ("05/2027", "indeterminado")
  foguetesQtd         Int?
  foguetesSubstituido Boolean @default(false)
  foguetesValidade    String?

  fachosQtd         Int?
  fachosSubstituido Boolean @default(false)
  fachosValidade    String?

  fumigenoQtd         Int?
  fumigenoSubstituido Boolean @default(false)
  fumigenoValidade    String?

  pilhasQtd         Int?
  pilhasSubstituido Boolean @default(false)
  pilhasValidade    String?

  racoesSolidasQtd         Int?
  racoesSolidasPesoGramas  Float?
  racoesSolidasSubstituido Boolean @default(false)
  racoesSolidasValidade    String?

  racoesLiquidasQtd         Int?
  racoesLiquidasVolumeMl    Float?
  racoesLiquidasSubstituido Boolean @default(false)
  racoesLiquidasValidade    String?

  medicamentosQtd         Int?
  medicamentosSubstituido Boolean @default(false)
  medicamentosValidade    String?

  pescaQtd         Int?
  pescaSubstituido Boolean @default(false)
  pescaValidade    String?

  reparosQtd         Int?
  reparosSubstituido Boolean @default(false)
  reparosValidade    String?

  enjooQtd         Int?
  enjooSubstituido Boolean @default(false)
  enjooValidade    String?

  bateriaResgateQtd         Int?
  bateriaResgateSubstituido Boolean @default(false)
  bateriaResgateValidade    String?

  // Checklist de componentes (verificado sim/não)
  ancoraFlutuante    Boolean @default(false)
  remos              Boolean @default(false)
  quadroSinais       Boolean @default(false)
  facaCaboFlutuante  Boolean @default(false)
  espelhoSinalizacao Boolean @default(false)
  copoGraduado       Boolean @default(false)
  aroFlutuante       Boolean @default(false)
  jarrosAgua         Boolean @default(false)
  documentacao       Boolean @default(false)
  lanternaEstanque   Boolean @default(false)
  apito              Boolean @default(false)
  protecaoTermica    Boolean @default(false)
  esponja            Boolean @default(false)
  refletorRadar      Boolean @default(false)
  abridorLatas       Boolean @default(false)
  foleManual         Boolean @default(false)

  // Teste de flutuadores (resumo)
  napRealizado Boolean @default(false)
  napValor     Float?
  wpRealizado  Boolean @default(false)
  wpValor      Float?
  giRealizado  Boolean @default(false)
  giValor      Float?
  fsRealizado  Boolean @default(false)
  fsValor      Float?
  olRealizado  Boolean @default(false)
  olValor      Float?
  temperatura  String?

  // Casulo (Glass Fiber Container) — reparo/pintura do casulo de fibra +
  // válvula de liberação hidrostática, seção própria no papel (abaixo de
  // Cilindro), nunca tinha campo nenhum no schema.
  casuloReparo            Boolean @default(false)
  casuloPintura           Boolean @default(false)
  casuloValvulaNumero     String?
  casuloValvulaFabricante String?
  casuloValvulaValidade   String?

  // Cabo de Disparo — um só por balsa (não por cilindro, mesmo quando há mais
  // de um), seção própria no papel ao lado do Casulo. Antes vivia em
  // CilindroRelatorio (repetido por linha, sem necessidade).
  caboInternoMetros           Float?
  caboExternoMetros           Float?
  alturaMaximaEstocagemMetros Float?

  // Página 3 do PDF — checklist "RELATÓRIO DE SERVIÇO DE BALSAS" (documento
  // avulso migrado, backend/migracao/RELATÓRIO DE SERVIÇOS DE BALSA.docx),
  // 23 serviços marcados sim/não + observações próprias (diferente de
  // `observacoes`, abaixo, que é do documento da 1ª página).
  servRevisaoTesteBalsa                Boolean @default(false)
  servLimpezaBalsa                     Boolean @default(false)
  servTransporteManipulacao            Boolean @default(false)
  servTratamentoSilicone               Boolean @default(false)
  servEmissaoLogCard                   Boolean @default(false)
  servEmissaoCertificadoBalsa          Boolean @default(false)
  servAparelhagemCasulo                Boolean @default(false)
  servPinturaCasulo                    Boolean @default(false)
  servReparoCasulo                     Boolean @default(false)
  servRevisaoValvulaHidrostatica       Boolean @default(false)
  servReparoValvula                    Boolean @default(false)
  servPinturaValvulaHidrostatica       Boolean @default(false)
  servTestePressaoHidrostaticaCilindro Boolean @default(false)
  servPinturaCilindro                  Boolean @default(false)
  servTesteCabecaDisparoCilindro       Boolean @default(false)
  servRecargaCilindro                  Boolean @default(false)
  servIdContainer                      Boolean @default(false)
  servReparoBerco                      Boolean @default(false)
  servPinturaBerco                     Boolean @default(false)
  servHorasExtras                      Boolean @default(false)
  servReparoBalsaPequeno               Boolean @default(false)
  servReparoBalsaMedio                 Boolean @default(false)
  servReparoBalsaGrande                Boolean @default(false)
  servicosObservacoes                  String?

  revisaoAnualOk Boolean?
  observacoes    String?
  // Técnico responsável pelo relatório impresso no rodapé da 2ª página
  // (abaixo de "Data de Atendimento") — nasce preenchido com o nome de quem
  // criou o relatório (criadoPor), mas é editável (pode ter sido outra pessoa
  // em campo). Diferente do TesteImo.tecnicoNome, que é só quem fez os
  // testes IMO especificamente.
  tecnicoNome    String?
  status         String   @default("preenchendo")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cilindros   CilindroRelatorio[]
  testeImo    TesteImo?
  assinaturas Assinatura[]
  certificado Certificado?

  @@index([status])
  @@index([ano, numero])
}

model CilindroRelatorio {
  id          Int       @id @default(autoincrement())
  relatorio   Relatorio @relation(fields: [relatorioId], references: [id])
  relatorioId Int

  numero               String?
  valvulaNumero        String?
  teste                String?
  carga                Float?
  cargaCO2             Float?
  cargaN2              Float?
  fabricante           String?
  anoFabricacao        String?
  validadeHidrostatica String?
  classe               String?

  // Não usados mais pelo app (Cabo de Disparo virou campo único em Relatorio,
  // ver lá) — mantidos aqui só pra não dropar coluna com dado já salvo numa
  // migração de schema (prisma db push sem --accept-data-loss recusaria).
  caboInternoMetros           Float?
  caboExternoMetros           Float?
  alturaMaximaEstocagemMetros Float?

  @@index([relatorioId])
}

// Testes formais de acordo com a Resolução IMO A.761(18) — versão detalhada dos
// mesmos 5 testes já resumidos em Relatorio (nap/wp/gi/fs/ol).
model TesteImo {
  id          Int       @id @default(autoincrement())
  relatorio   Relatorio @relation(fields: [relatorioId], references: [id])
  relatorioId Int       @unique

  wpRealizado Boolean?
  wpAnual     Boolean?

  wpSupInicioTemp     String?
  wpSupInicioPressao  Float?
  wpSupTerminoTemp    String?
  wpSupTerminoPressao Float?
  wpSupDiff           Float?
  wpSupDiffPct        Float?

  wpInfInicioTemp     String?
  wpInfInicioPressao  Float?
  wpInfTerminoTemp    String?
  wpInfTerminoPressao Float?
  wpInfDiff           Float?
  wpInfDiffPct        Float?

  giRealizado          Boolean?
  giPressaoMaxSuperior Float?
  giPressaoMaxInferior Float?
  giTuboSuperiorOk     Boolean?
  giTuboInferiorOk     Boolean?

  napRealizado Boolean?

  napSupInicio  Float?
  napSupTermino Float?
  napSupDiff    Float?
  napSupDiffPct Float?

  napInfInicio  Float?
  napInfTermino Float?
  napInfDiff    Float?
  napInfDiffPct Float?

  napRachaduras      Boolean?
  napAberturaCostura Boolean?

  fsRealizado   Boolean?
  fsResultadoOk Boolean?
  fsObservacoes String?

  olRealizado   Boolean?
  olPessoasNr   Int?
  olPesoPessoas Float?
  olPesoBalsa   Float?
  olPesoTotal   Float?
  olObservacoes String?

  tecnicoNome       String?
  controladoPorNome String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// ─── Certificado (etapa final do fluxo: OS → Relatório → Certificado) ─────────
// Pode ser gerado a partir de um Relatório concluído (botão "Gerar Certificado")
// OU criado avulso, sem Relatório/OS — necessário durante a transição pro
// sistema novo (OS/Relatório ainda preenchidos no papel) e pra importar
// certificados antigos que nunca tiveram esse rastro digital. Nasce "pendente"
// e só vira "emitido" quando um gerente/admin revisa e emite (define data de
// emissão e validade). Por enquanto só cobre balsa — os outros tipos do
// formulário avulso antigo (baleeira/turco/colete) ainda não têm OS/Relatório
// próprios.
// status: pendente | emitido | cancelado (cancelado fica no banco e não libera
// o número; excluir de vez — sem status próprio — libera o número pro próximo)
model Certificado {
  id           Int         @id @default(autoincrement())
  numero       Int
  ano          Int
  empresa      Empresa     @relation(fields: [empresaId], references: [id])
  empresaId    Int
  embarcacao   Embarcacao? @relation(fields: [embarcacaoId], references: [id])
  embarcacaoId Int?
  relatorio    Relatorio?  @relation(fields: [relatorioId], references: [id])
  relatorioId  Int?        @unique

  // Texto livre — NÃO exige cadastro prévio de Embarcacao/Cliente. O
  // certificado avulso é a porta de entrada durante a transição pro sistema
  // novo e pra importar certificados antigos: o cadastro formal da
  // embarcação/armador pode ser feito depois, sem bloquear a emissão agora.
  // embarcacaoId (acima) só existe quando o certificado vem de um Relatório
  // de verdade — o conteúdo impresso sempre lê daqui, nunca da Embarcacao.
  navio         String?
  armador       String?
  portoRegistro String?
  telefone      String?
  email         String?

  equipTipo          String?
  equipNumeroSerie   String?
  equipAnoFabricacao String?
  equipFabricante    String?
  equipModelo        String?
  equipClasse        String?
  equipCapacidade    Int?

  // "Segunda página" do certificado (Lista de Verificação e Reparos — kit de
  // sobrevivência, checklist, testes de flutuador, cilindros, testes IMO) pro
  // certificado AVULSO, que não tem Relatório nenhum onde guardar isso. Mesmo
  // formato que lerCamposTecnicosRelatorio() devolve no frontend — um JSON em
  // vez de duplicar ~50 colunas do Relatorio aqui. Certificado com Relatório
  // vinculado ignora este campo (usa os dados do Relatorio de verdade).
  dadosTecnicos Json?

  dataEmissao DateTime?
  validade    String?
  // validade é texto livre (digitável), mesmo padrão dos outros campos de validade do Relatorio
  observacoes String?

  status      String   @default("pendente")
  criadoPor   Usuario? @relation(fields: [criadoPorId], references: [id])
  criadoPorId Int?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  assinaturas Assinatura[]

  @@index([status])
  @@index([ano, numero])
}

model Colaborador {
  id               Int      @id @default(autoincrement())
  nome             String
  cpf              String?  @unique
  // cpf: só dígitos
  emailPessoal     String?
  emailCorporativo String?
  funcao           String
  // funcao: gerente_operacional | gerente_comercial | gerente_administrativo |
  // gerente_financeiro | auxiliar_manutencao | assistente_administrativo |
  // assistente_comercial | tecnico_n1 | tecnico_n2 | tecnico_n3 | engenheiro | estagiario
  // (lista e regras de vendedor/técnico em routes/colaboradores.js)
  // Desconto mensal do plano de saúde (R$), opcional — a Folha de pagamento
  // puxa esse valor ao ser gerada (a coparticipação é digitada na própria folha)
  descontoPlanoSaude Float?
  // Salário — obrigatório no cadastro (validado em routes/colaboradores.js), mas
  // opcional no banco porque colaboradores cadastrados antes do campo não têm.
  // A unidade depende do tipoContrato: mensalista = R$/mês; intermitente = R$/DIA
  // (os dias trabalhados no mês são digitados na Folha — ItemFolhaPagamento.diasTrabalhados)
  salario            Float?
  // Obsoleto, não usado: valor do VT (o desconto é sempre 6% do salário). Mantido
  // no banco só porque apagar coluna com dados faz o `prisma db push` do deploy
  // falhar (roda sem --accept-data-loss) — pode sair quando estiver vazia em prod.
  valeTransporte          Float?
  // Optou pelo vale-transporte → desconta 6% do salário (aparece na Folha)
  descontoValeTransporte  Boolean  @default(false)
  // Recebe auxílio moradia → valor (R$/mês) obrigatório; a Folha puxa o valor
  // Tipo de contrato: mensalista | intermitente — obrigatório no cadastro
  // (routes/colaboradores.js), opcional no banco pelos cadastrados antes do campo
  tipoContrato            String?
  auxilioMoradia          Boolean  @default(false)
  valorAuxilioMoradia     Float?
  // Próximo período de férias (datas puras, meia-noite UTC, inclusivas), opcional.
  // Admin/gerente veem aviso na página inicial e em Colaboradores de 30 dias
  // antes do início até o fim (GET /colaboradores/ferias-avisos)
  feriasInicio DateTime?
  feriasFim    DateTime?
  ativo            Boolean  @default(true)
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt

  // Login do sistema correspondente a este colaborador (1:1, opcional)
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId Int?     @unique

  documentos DocumentoColaborador[]
  embarques  EmbarqueColaborador[]
  itensFolha ItemFolhaPagamento[]
}

// Documentos pessoais do colaborador (PDF). Ficam fora da pasta uploads/ pública
// e só são servidos para admin/gerente — ver routes/colaboradores.js
model DocumentoColaborador {
  id            Int         @id @default(autoincrement())
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  colaboradorId Int
  titulo        String
  nomeOriginal  String
  nomeArquivo   String
  criadoEm      DateTime    @default(now())

  @@index([colaboradorId])
}

// ─── Embarque (Serviços → Embarques) ──────────────────────────────────────────
// Período em que colaboradores ficam embarcados numa embarcação. dataInicio e
// dataFim são datas puras (meia-noite UTC), ambas inclusivas: 10/09 → 12/09 = 3 dias.
// Folgas e dobras NÃO são gravadas — são calculadas a partir dos embarques de
// cada colaborador (ver calcularDiasColaborador em routes/embarques.js), pra que
// editar/excluir um embarque antigo recalcule tudo o que vem depois. A folha de
// pagamento, quando existir, é que deve congelar os valores de um período fechado.
// armador é cópia do armador da embarcação no momento do embarque (editável).
// O período do Embarque é o da operação inteira; cada colaborador pode ter ficado
// só parte dele (subiu depois / desceu antes) — ver EmbarqueColaborador.
model Embarque {
  id           Int        @id @default(autoincrement())
  embarcacao   Embarcacao @relation(fields: [embarcacaoId], references: [id])
  embarcacaoId Int
  armador      Cliente    @relation(fields: [armadorId], references: [id])
  armadorId    Int

  dataInicio  DateTime
  dataFim     DateTime
  observacoes String?

  criadoPor    Usuario? @relation(fields: [criadoPorId], references: [id])
  criadoPorId  Int?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  colaboradores EmbarqueColaborador[]

  @@index([dataInicio])
}

model EmbarqueColaborador {
  id            Int         @id @default(autoincrement())
  embarque      Embarque    @relation(fields: [embarqueId], references: [id], onDelete: Cascade)
  embarqueId    Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  colaboradorId Int

  // Período individual do colaborador dentro do embarque (datas puras, inclusivas).
  // null = igual ao do Embarque — só é gravado quando difere, pra que mudar as
  // datas do embarque continue valendo pra quem ficou o período inteiro. É esse
  // período (e não o do Embarque) que conta pra folga/dobra e pra folha.
  dataInicio DateTime?
  dataFim    DateTime?

  @@unique([embarqueId, colaboradorId])

  @@index([colaboradorId])
}

// ─── Folha de pagamento (Financeiro → Folha de pagamento) ─────────────────────
// Uma por mês. Ao gerar, cria um ItemFolhaPagamento por colaborador ativo com o
// que dá pra puxar sozinho (embarques/dobras do mês, desconto do plano de saúde
// do cadastro, comissões das vendas do mês); o resto é digitado na tela.
// Os itens são CÓPIA (nome, função, embarques...) — enquanto a folha está
// "aberta" dá pra atualizar os dados automáticos; "fechada" congela tudo, mesmo
// que embarques/vendas/cadastros mudem depois.
model FolhaPagamento {
  id     Int    @id @default(autoincrement())
  mes    Int
  ano    Int
  status String @default("aberta")
  // status: aberta | fechada

  criadoPor    Usuario?  @relation(fields: [criadoPorId], references: [id])
  criadoPorId  Int?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  fechadaEm    DateTime?

  itens ItemFolhaPagamento[]

  @@unique([ano, mes])
}

model ItemFolhaPagamento {
  id            Int            @id @default(autoincrement())
  folha         FolhaPagamento @relation(fields: [folhaId], references: [id], onDelete: Cascade)
  folhaId       Int
  colaborador   Colaborador    @relation(fields: [colaboradorId], references: [id])
  colaboradorId Int

  // Cópias do cadastro no momento da geração
  nome   String
  funcao String
  tipoContrato String?
  grupo  String
  // grupo: base | tecnicos | estagiarios (técnico → tecnicos, estagiário →
  // estagiarios, o resto → base)

  // Automáticos (vêm de Embarques — ver calcularDiasColaborador em routes/embarques.js)
  embarques      String?
  // embarques: períodos embarcados no mês, ex.: "10/09 a 12/09 (NAVIO X); 20/09 a 22/09 (NAVIO Y)"
  diasEmbarcados Int     @default(0)
  diasDobra      Int     @default(0)
  // Optou pelo vale-transporte (cópia de Colaborador.descontoValeTransporte) — a
  // folha só mostra Sim/Não, sem valor
  valeTransporte Boolean @default(false)
  // Dias trabalhados no mês, só pra intermitente (o salário dele no cadastro é
  // por dia). Nasce igual aos dias embarcados e é editável; "atualizar dados
  // automáticos" só o refaz se ninguém editou (ver routes/folha-pagamento.js).
  diasTrabalhados Int?

  // Valores (R$) — descontoPlanoSaude e comissao vêm preenchidos, todos editáveis
  descontoPlanoSaude       Float?
  // Cópia do valor do auxílio moradia do cadastro (null = não recebe), editável
  auxilioMoradia           Float?
  coparticipacaoPlanoSaude Float?
  ajudaCusto               Float?
  premio                   Float?
  comissao                 Float?
  observacoes              String?

  @@unique([folhaId, colaboradorId])

  @@index([colaboradorId])
}

// ─── Trilha de auditoria ──────────────────────────────────────────────────────
// Uma linha por requisição que ALTERA dados (POST/PUT/PATCH/DELETE) concluída com
// sucesso — gravada pelo middleware em middleware/auditoria.js. usuarioNome é
// cópia (o log não pode mudar se o usuário for renomeado/removido). dados é o
// corpo da requisição, sem senhas/assinaturas.
model LogAuditoria {
  id          Int      @id @default(autoincrement())
  usuarioId   Int?
  usuarioNome String?
  metodo      String
  rota        String
  entidade    String
  // entidade: primeiro trecho da rota (contratos, ocs, pagamentos...)
  entidadeId  Int?
  dados       Json?
  criadoEm    DateTime @default(now())

  @@index([criadoEm])
  @@index([usuarioId])
  @@index([entidade, entidadeId])
}
